@page "/canciones"
@using DDMChords.Models
@using DDMChords.Services
@using DDMChords.Shared.Components
@inject StorageService Storage
@inject NavigationManager Navigation

<PageTitle>Canciones - DDMChords</PageTitle>

<div class="page-header" style="display: flex; justify-content: space-between; align-items: center;">
    <h2>Repertorio</h2>
    <button class="btn btn-outline-info" onclick="window.print()">🖨️ Imprimir Repertorio</button>
</div>
<SearchBar @bind-SearchTerm="terminoBusqueda" />

@if (canciones == null) { 
    <div class="loading-state">Cargando repertorio...</div> 
}
else if (!cancionesFiltradas.Any()) { 
    <div class="empty-state neumorphism-card">No se encontraron canciones.</div> 
}
else {
    <div class="songs-grid">
        @foreach (var cancion in cancionesFiltradas) { 
            <SongCard Cancion="cancion" OnSongSelected="IrACancion" OnSongDeleted="BorrarCancion" /> 
        }
    </div>
}

@code {
    private List<CancionModel>? canciones;
    private string terminoBusqueda = string.Empty;
    private IEnumerable<CancionModel> cancionesFiltradas => 
        string.IsNullOrWhiteSpace(terminoBusqueda) ? 
        (canciones ?? new()) : 
        (canciones ?? new()).Where(c => c.Titulo.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) || c.Artista.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase));
        
    protected override async Task OnInitializedAsync() {
        canciones = await Storage.ObtenerRepertorioAsync();
    }
    private void IrACancion(int id) => Navigation.NavigateTo($"cancion/{id}");
    
    private async Task BorrarCancion(int id) {
        var cancion = canciones?.FirstOrDefault(c => c.Id == id);
        if (cancion != null) {
            canciones?.Remove(cancion);
            await Storage.GuardarRepertorioAsync(canciones ?? new());
        }
    }
}

<style>
    .page-header { margin-bottom: 2rem; }
    .page-header h2 { font-size: 2rem; font-weight: 700; color: var(--text); margin: 0; }
    .btn-outline-info { border: 1px solid #06B6D4; color: #06B6D4; background: transparent; cursor: pointer; border-radius: 8px; padding: 8px 16px; transition: all 150ms; font-weight: bold; }
    .btn-outline-info:hover { background: rgba(6,182,212,0.1); }
    .songs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
    .neumorphism-card { background-color: var(--surface); border: none; box-shadow: inset 2px 2px 5px rgba(255,255,255,0.03), inset -3px -3px 7px rgba(0,0,0,0.4); }
    .empty-state { text-align: center; padding: 3rem; color: var(--text-muted); border-radius: 12px; }
</style>
