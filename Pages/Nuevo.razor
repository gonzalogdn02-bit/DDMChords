@page "/nuevo"
@using DDMChords.Models
@using DDMChords.Services
@using DDMChords.Shared.Components
@inject StorageService Storage
@inject TransposerService Transposer
@inject NavigationManager Navigation

<PageTitle>Nueva Canción - DDMChords</PageTitle>

<div class="split-view">
    <div class="form-card neumorphism-card">
        <h2 class="form-title">Agregar Nueva Canción</h2>
        
        <div class="form-group">
            <label>Título</label>
            <input type="text" class="input-neumorphism" @bind="nuevaCancion.Titulo" @bind:event="oninput" />
        </div>

        <div class="form-group">
            <label>Autor / Artista</label>
            <input type="text" class="input-neumorphism" @bind="nuevaCancion.Artista" @bind:event="oninput" />
        </div>

        <div class="row-group">
            <div class="form-group flex-1">
                <label>Tono Original</label>
                <select class="input-neumorphism" @bind="nuevaCancion.TonoOriginal">
                    @foreach (var note in new[] { "C","Cm","C#","C#m","Db","Dbm","D","Dm","D#","D#m","Eb","Ebm","E","Em","F","Fm","F#","F#m","Gb","Gbm","G","Gm","G#","G#m","Ab","Abm","A","Am","A#","A#m","Bb","Bbm","B","Bm" }) {
                        <option value="@note">@note</option>
                    }
                </select>
            </div>
            
            <div class="form-group flex-1">
                <label>Tono Deseado (Preview)</label>
                <select class="input-neumorphism" @bind="nuevaCancion.TonoActual">
                    @foreach (var note in new[] { "C","Cm","C#","C#m","Db","Dbm","D","Dm","D#","D#m","Eb","Ebm","E","Em","F","Fm","F#","F#m","Gb","Gbm","G","Gm","G#","G#m","Ab","Abm","A","Am","A#","A#m","Bb","Bbm","B","Bm" }) {
                        <option value="@note">@note</option>
                    }
                </select>
            </div>
            
            <div class="form-group flex-1">
                <label>BPM</label>
                <input type="number" class="input-neumorphism" @bind="nuevaCancion.Bpm" @bind:event="oninput" />
            </div>
        </div>

        <div class="form-group">
            <label>Letra con Acordes</label>
            <textarea class="input-neumorphism" rows="12" @bind="nuevaCancion.LetraConAcordes" @bind:event="oninput" placeholder="G            C\nEscribe aquí los acordes y la letra..."></textarea>
        </div>

        <button class="btn-primary form-submit btn-neumorphism" @onclick="Guardar">Guardar Tema</button>
    </div>

    <!-- Live Preview -->
    <div class="preview-card neumorphism-inset">
        <h3 class="preview-title">Vista Previa en Tiempo Real</h3>
        <div class="preview-chords">
            <ChordViewer LetraOriginal="@(Transposer.TransponerAcordes(nuevaCancion.LetraConAcordes, nuevaCancion.TonoOriginal, nuevaCancion.TonoActual))" />
        </div>
    </div>
</div>

@code {
    private CancionModel nuevaCancion = new CancionModel { TonoOriginal = "C", TonoActual = "C", Bpm = 120 };

    private async Task Guardar() {
        if (string.IsNullOrWhiteSpace(nuevaCancion.Titulo)) return;
        var canciones = await Storage.ObtenerRepertorioAsync();
        nuevaCancion.Id = canciones.Any() ? canciones.Max(c => c.Id) + 1 : 1;
        nuevaCancion.Tonalidad = nuevaCancion.TonoOriginal;
        canciones.Add(nuevaCancion);
        await Storage.GuardarRepertorioAsync(canciones);
        Navigation.NavigateTo("/canciones");
    }
}

<style>
    .split-view { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; margin-top: 1rem; }
    .neumorphism-card { background-color: var(--surface); border: none; box-shadow: 5px 5px 15px rgba(0,0,0,0.5), -3px -3px 10px rgba(255,255,255,0.03); border-radius: 16px; padding: 2rem; }
    .neumorphism-inset { background-color: var(--surface); border: none; box-shadow: inset 3px 3px 8px rgba(0,0,0,0.6), inset -2px -2px 6px rgba(255,255,255,0.02); border-radius: 16px; padding: 2rem; }
    .input-neumorphism { background-color: #0D1117; border: none; box-shadow: inset 2px 2px 5px rgba(0,0,0,0.6), inset -1px -1px 3px rgba(255,255,255,0.05); color: var(--text); border-radius: 8px; padding: 12px 14px; font-family: var(--font-sans); }
    .input-neumorphism:focus { outline: none; box-shadow: inset 2px 2px 5px rgba(0,229,255,0.2), inset -1px -1px 3px rgba(255,255,255,0.05); }
    textarea.input-neumorphism { font-family: var(--font-mono); resize: vertical; }
    .btn-neumorphism { box-shadow: 3px 3px 8px rgba(0,0,0,0.4), -1px -1px 4px rgba(255,255,255,0.1); }
    .btn-neumorphism:active { box-shadow: inset 2px 2px 5px rgba(0,0,0,0.5); transform: scale(0.98); }
    
    .form-title { color: var(--primary); font-size: 1.5rem; font-weight: 700; margin-bottom: 2rem; }
    .form-group { display: flex; flex-direction: column; margin-bottom: 1.5rem; gap: 0.5rem; }
    .row-group { display: flex; gap: 1rem; }
    .flex-1 { flex: 1; }
    .form-group label { color: var(--text-muted); font-size: 0.85rem; }
    .form-submit { width: 100%; margin-top: 1rem; padding: 12px; border-radius: 8px; font-size: 1.1rem; background-color: #005F73; color: white; border: none; cursor: pointer; }
    
    .preview-title { color: var(--text-muted); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; }
    .preview-chords { background: transparent; }

    @@media (max-width: 768px) {
        .split-view { grid-template-columns: 1fr; }
        .row-group { flex-direction: column; }
    }
</style>
