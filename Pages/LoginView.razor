<div class="clay-card" style="max-width: 400px; margin: auto; height: auto; align-items: center;">
    <div style="background: #4c1d95; border: 2px solid #a855f7; width: 50px; height: 50px; border-radius: 50%; margin-bottom: 10px; line-height: 46px; font-size: 16pt; text-align: center;">🙌</div>
    <h1 style="font-size: 14pt; font-weight: 800; color: #fff;">DIOS DE MAJESTAD</h1>
    <p style="font-size: 8pt; color: #c084fc; font-weight: 700; margin-bottom: 15px;">MINISTERIO DE MÚSICA</p>
    
    <p style="font-size: 8pt; color: #94a3b8; font-weight: 700; margin-bottom: 8px;">SELECCIONA TU INSTRUMENTO</p>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; width: 100%; margin-bottom: 15px;">
        @foreach (var inst in diccionarioClaves.Keys)
        {
            <button class="btn-glass @(instSeleccionado == inst ? "btn-active" : "")" style="padding: 10px 0; font-size: 9pt;" @onclick="() => instSeleccionado = inst">
                @inst
            </button>
        }
    </div>
    
    <p style="font-size: 8pt; color: #94a3b8; font-weight: 700; margin-bottom: 8px;">CONTRASEÑA DE LA BANDA</p>
    <input type="password" class="panel-dark" style="width:100%; border:none; color:#38bdf8; font-size:14pt; letter-spacing:0.3em; text-align:center; outline:none; margin-bottom: 15px;" @bind="passwordInput" />
    
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <p style="color: #ef4444; font-size: 8pt; margin-bottom: 10px; font-weight: bold;">@mensajeError</p>
    }

    <button class="btn-glass btn-active" style="width: 100%; padding: 12px; font-weight: bold;" @onclick="ManejarLogin">INGRESAR</button>
</div>

@code {
    [Parameter] public EventCallback<string> OnLoginExitoso { get; set; }
    private string instSeleccionado = "Guitarra Eléctrica";
    private string passwordInput = "";
    private string mensajeError = "";
    
    // Contraseñas personalizadas por instrumento (según PDF)
    private Dictionary<string, string> diccionarioClaves = new() {
        { "Voz Principal", "voz123" },
        { "Coro 1", "coro123" },
        { "Guitarra Eléctrica", "gtr777" },
        { "Gtr Acústica 1", "acu888" },
        { "Teclado", "keys999" },
        { "Batería", "drums000" }
    };

    private async Task ManejarLogin()
    {
        if (diccionarioClaves.ContainsKey(instSeleccionado) && passwordInput == diccionarioClaves[instSeleccionado])
        {
            mensajeError = "";
            await OnLoginExitoso.InvokeAsync(instSeleccionado);
        }
        else
        {
            mensajeError = "Contraseña incorrecta.";
        }
    }
}